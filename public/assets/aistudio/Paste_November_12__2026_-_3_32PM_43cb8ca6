    },
    {
      id: 'MSG-03',
      sender: 'Linda Turner',
      role: 'Parent · Hannah Turner (Class 302)',
      initials: 'LT',
      color: 'bg-[#FAD2CF] text-[#942922]',
      time: 'Yesterday',
      unread: false,
