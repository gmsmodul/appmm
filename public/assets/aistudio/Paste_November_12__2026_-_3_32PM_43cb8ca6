                    .filter(p => prepFilterClass === 'All' || p.classCode === prepFilterClass)
                    .map((plan) => {
                      const theme = PASTEL_THEMES[plan.theme] || PASTEL_THEMES.periwinkle;
                      const isSelected = activePlan?.id === plan.id;
                      return (
                        <div
                          key={plan.id}
                          onClick={() => setSelectedPlanId(plan.id)}
                          className={`${theme.bg} rounded-[22px] p-5 cursor-pointer transition-all border-2 ${
                            isSelected ? 'border-[#1C1D21] shadow-sm' : 'border-transparent hover:-translate-y-0.5'
                          }`}
                        >
                          <div className="flex items-center justify-between gap-2">
                            <div className="flex items-center gap-2.5">
                              <span className="bg-white text-[#1C1D21] text-[11.5px] font-bold px-3 py-1 rounded-full shadow-2xs">
                                {plan.classCode}
                              </span>
                              <span className="text-[12px] font-medium text-[#5A5D67]">{plan.subject}</span>
                            </div>
                            <span className="bg-white/90 text-[#1C1D21] text-[11px] font-semibold px-3 py-1 rounded-full">
                              {plan.status} · {plan.progress}%
                            </span>
                          </div>

                          <h3 className="text-[16px] font-semibold text-[#1C1D21] mt-3">{plan.topic}</h3>

                          <div className="mt-4 space-y-2">
                            <div className="w-full h-2 bg-white/70 rounded-full overflow-hidden">
                              <div
                                className="h-full bg-[#1C1D21] rounded-full transition-all duration-300"
                                style={{ width: `${plan.progress}%` }}
                              />
                            </div>
                            <div className="flex items-center justify-between text-[11.5px] text-[#5A5D67]">
                              <span>Scheduled: {plan.date}</span>
                              <span>{plan.materials.length} attachments</span>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                </div>

                {/* Module Readiness Inspector */}
                {activePlan && (
                  <div className="xl:col-span-5 bg-[#FAFBFD] rounded-[24px] p-6 border border-black/[0.04] space-y-5 self-start">
                    <div className="flex items-start justify-between gap-2">
                      <div>
                        <span className="text-[11px] font-bold uppercase tracking-wider text-[#8A8D98]">
                          Module Readiness Inspector
                        </span>
                        <h2 className="text-[17px] font-semibold text-[#1C1D21] mt-1">{activePlan.topic}</h2>
                        <p className="text-[12px] text-[#6E717A] mt-0.5">
                          {activePlan.classCode} · {activePlan.date}
                        </p>
                      </div>
                      <span className="text-[13px] font-bold bg-[#1C1D21] text-white px-3 py-1 rounded-full">
                        {activePlan.progress}%
                      </span>
                    </div>

                    {/* Interactive Checklist */}
                    <div className="space-y-2">
                      <div className="text-[12.5px] font-semibold text-[#1C1D21]">Preparation Checklist</div>
                      {activePlan.checklist.map((item) => (
                        <button
                          key={item.id}
                          onClick={() => toggleChecklistItem(activePlan.id, item.id)}
                          className="w-full flex items-center gap-3 bg-white p-3 rounded-2xl border border-black/[0.04] text-left hover:bg-[#F4F5F8] transition-colors"
                        >
                          {item.done ? (
                            <CheckSquare className="w-4 h-4 text-[#10B981] shrink-0" />
                          ) : (
                            <Square className="w-4 h-4 text-[#9496A1] shrink-0" />
                          )}
                          <span className={`text-[13px] ${item.done ? 'line-through text-[#9496A1]' : 'text-[#1C1D21] font-medium'}`}>
                            {item.label}
                          </span>
                        </button>
                      ))}

                      <form onSubmit={handleAddChecklistTask} className="flex gap-2 pt-1">
                        <input
                          type="text"
                          value={newTaskText}
                          onChange={(e) => setNewTaskText(e.target.value)}
                          placeholder="Add preparation step..."
                          className="flex-1 bg-white border border-black/[0.08] rounded-full px-3.5 py-2 text-[12.5px] outline-none focus:border-[#1C1D21]"
                        />
                        <button
                          type="submit"
                          className="px-4 py-2 rounded-full bg-[#1C1D21] text-white text-[12px] font-medium hover:bg-[#2E3036]"
                        >
                          Add
                        </button>
                      </form>
                    </div>

                    {/* Attached Materials */}
                    <div className="space-y-2 pt-2 border-t border-black/[0.05]">
                      <div className="text-[12.5px] font-semibold text-[#1C1D21]">Attached Materials</div>
                      {activePlan.materials.map((mat, idx) => (
                        <div
                          key={idx}
                          className="bg-white px-3.5 py-2.5 rounded-2xl border border-black/[0.04] flex items-center justify-between"
                        >
                          <div className="flex items-center gap-2.5 min-w-0">
                            <span className="px-2 py-0.5 rounded-md bg-[#ECEBFF] text-[#3F3B99] text-[10px] font-bold">
                              {mat.type}
                            </span>
                            <span className="text-[12.5px] font-medium text-[#1C1D21] truncate">{mat.name}</span>
                          </div>
                          <span className="text-[11px] text-[#8A8D98] shrink-0">{mat.size}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ================================================================
              VIEW: ATTENDANCE
             ================================================================ */}
          {activePage === 'attendance' && (
            <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                <div>
                  <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Attendance</h1>
                  <p className="text-[13px] text-[#8A8D98] mt-0.5">
                    On the attendance page, you can easily track student attendance and monitor absences.
                  </p>
                </div>

                {/* Class Switcher Pills */}
                <div className="flex items-center gap-2 bg-[#F4F5F8] p-1.5 rounded-full border border-black/[0.04] self-start">
                  {Object.keys(STUDENTS_DATA).map((cls) => {
                    const active = selectedClass === cls;
                    return (
                      <button
                        key={cls}
                        onClick={() => setSelectedClass(cls)}
                        className={`flex items-center gap-1.5 px-4 py-1.5 rounded-full text-[12.5px] font-medium transition-all ${
                          active ? 'bg-[#1C1D21] text-white shadow-xs' : 'text-[#6E717A] hover:text-[#1C1D21]'
                        }`}
                      >
                        {active && <CheckCircle2 className="w-3.5 h-3.5" />}
                        <span>{cls}</span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* 12-Col Layout: Left Calendar & Segmented Bars (4 Cols) | Right 3 Status Columns (8 Cols) */}
              <div className="grid grid-cols-1 xl:grid-cols-12 gap-7">
                {/* Left 4 Columns */}
                <div className="xl:col-span-4 space-y-5">
                  {/* Compact Calendar */}
                  <div className="bg-[#FAFBFD] rounded-[24px] p-5 border border-black/[0.04]">
                    <div className="flex items-center justify-between mb-4">
                      <div className="flex items-center gap-2">
                        <button className="w-7 h-7 rounded-full border border-black/[0.07] flex items-center justify-center hover:bg-white">
                          <ChevronLeft className="w-3.5 h-3.5" />
                        </button>
                        <span className="text-[14px] font-semibold text-[#1C1D21]">February</span>
                        <button className="w-7 h-7 rounded-full border border-black/[0.07] flex items-center justify-center hover:bg-white">
                          <ChevronRight className="w-3.5 h-3.5" />
                        </button>
                      </div>
                      <button className="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-black/[0.06] text-[12px] font-medium">
                        <Filter className="w-3 h-3" />
                        <span>Filter</span>
                        <span className="w-4 h-4 rounded-full bg-[#1C1D21] text-white text-[10px] flex items-center justify-center">1</span>
                      </button>
                    </div>

                    <div className="grid grid-cols-7 text-center text-[11px] font-semibold text-[#8A8D98] mb-2">
                      {['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'].map(d => <div key={d}>{d}</div>)}
                    </div>
                    <div className="grid grid-cols-7 gap-1.5 text-center text-[12px]">
                      {Array.from({ length: 28 }, (_, i) => i + 1).map(day => {
                        const isSelected = attendanceDay === day;
                        return (
                          <button
                            key={day}
                            onClick={() => setAttendanceDay(day)}
                            className={`h-8 rounded-full font-medium transition-all ${
                              isSelected
                                ? 'bg-[#1C1D21] text-white font-bold shadow-xs'
                                : 'bg-white text-[#1C1D21] hover:bg-[#ECEBFF]'
                            }`}
                          >
                            {day}
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  {/* Segmented Progress Summary Cards */}
                  <div className="space-y-3">
                    <div className="bg-[#EEF8F3] rounded-[20px] p-4 flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#10B981]">
                          <Check className="w-4 h-4" />
                        </div>
                        <div>
                          <div className="text-[14px] font-bold text-[#1C1D21]">23/24</div>
                          <div className="text-[11.5px] text-[#6E717A]">Attendance</div>
                        </div>
                      </div>
                      <div className="flex items-center gap-[3px]">
                        {Array.from({ length: 14 }).map((_, i) => (
                          <span
                            key={i}
                            className={`w-1.5 h-5 rounded-full ${i < 13 ? 'bg-[#10B981]' : 'bg-black/10'}`}
                          />
                        ))}
                      </div>
                    </div>

                    <div className="bg-[#FFF5EE] rounded-[20px] p-4 flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#EF4444]">
                          <X className="w-4 h-4" />
                        </div>
                        <div>
                          <div className="text-[14px] font-bold text-[#1C1D21]">1/24</div>
                          <div className="text-[11.5px] text-[#6E717A]">Absences</div>
                        </div>
                      </div>
                      <div className="flex items-center gap-[3px]">
                        {Array.from({ length: 14 }).map((_, i) => (
                          <span
                            key={i}
                            className={`w-1.5 h-5 rounded-full ${i >= 12 ? 'bg-[#D97706]' : 'bg-black/10'}`}
                          />
                        ))}
                      </div>
                    </div>

                    <div className="bg-[#F4F2FF] rounded-[20px] p-4 flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#7A74FF]">
                          <Clock className="w-4 h-4" />
                        </div>
                        <div>
                          <div className="text-[14px] font-bold text-[#1C1D21]">1/24</div>
                          <div className="text-[11.5px] text-[#6E717A]">Delayed</div>
                        </div>
                      </div>
                      <div className="flex items-center gap-[3px]">
                        {Array.from({ length: 14 }).map((_, i) => (
                          <span
                            key={i}
                            className={`w-1.5 h-5 rounded-full ${i >= 12 ? 'bg-[#7A74FF]' : 'bg-black/10'}`}
                          />
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                {/* Right 8 Columns: Attendance, Absences, Delayed Lists */}
                <div className="xl:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-4">
                  {[
                    { key: 'attendance', title: 'Attendance', icon: Check, iconColor: 'text-[#10B981]' },
                    { key: 'absences', title: 'Absences', icon: X, iconColor: 'text-[#EF4444]' },
                    { key: 'delayed', title: 'Delayed', icon: AlertCircle, iconColor: 'text-[#7A74FF]' },
                  ].map((col) => {
                    const list = STUDENTS_DATA[selectedClass]?.[col.key] || [];
                    const ColIcon = col.icon;
                    return (
                      <div key={col.key} className="bg-[#FAFBFD] rounded-[22px] p-4 border border-black/[0.04] space-y-3">
                        <div className="flex items-center justify-between px-1">
                          <div className="flex items-center gap-2">
                            <ColIcon className={`w-4 h-4 ${col.iconColor}`} />
                            <span className="text-[13.5px] font-semibold text-[#1C1D21]">{col.title}</span>
                          </div>
                          <span className="w-5 h-5 rounded-full bg-[#1C1D21] text-white text-[11px] font-semibold flex items-center justify-center">
                            {list.length}
                          </span>
                        </div>

                        <div className="space-y-2">
                          {list.length === 0 ? (
                            <div className="text-center py-8 text-[12px] text-[#9496A1]">No records</div>
                          ) : (
                            list.map((st) => (
                              <button
                                key={st.id}
                                onClick={() => setSelectedStudentDrawer(st)}
                                className="w-full bg-white hover:bg-[#F4F5F8] px-3 py-2.5 rounded-2xl border border-black/[0.04] flex items-center justify-between transition-colors text-left"
                              >
                                <div className="flex items-center gap-2.5 min-w-0">
                                  <span className={`w-7 h-7 rounded-full flex items-center justify-center text-[10.5px] font-bold shrink-0 ${st.color}`}>
                                    {st.initials}
                                  </span>
                                  <span className="text-[12.5px] font-medium text-[#1C1D21] truncate">{st.name}</span>
                                </div>
                                <ChevronRight className="w-3.5 h-3.5 text-[#9496A1] shrink-0" />
                              </button>
                            ))
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          {/* ================================================================
              VIEW: EXAMS
             ================================================================ */}
          {activePage === 'exams' && (
            <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                <div>
                  <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Exams</h1>
                  <p className="text-[13px] text-[#8A8D98] mt-0.5">
                    Schedule, organize, and track confirmed examinations across classes.
                  </p>
                </div>

                <div className="flex items-center gap-2.5">
                  <div className="relative">
                    <Search className="w-4 h-4 text-[#8A8D98] absolute left-3.5 top-1/2 -translate-y-1/2" />
                    <input
                      type="text"
                      value={examSearch}
                      onChange={(e) => setExamSearch(e.target.value)}
                      placeholder="Search exam or class..."
                      className="pl-9 pr-4 py-2 rounded-full border border-black/[0.08] text-[13px] bg-white outline-none focus:border-[#1C1D21]"
                    />
                  </div>
                  <button
                    onClick={() => setIsAddExamOpen(true)}
                    className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                  >
                    <Plus className="w-4 h-4" />
                    <span>Add new exam</span>
                  </button>
                </div>
              </div>

              <div className="grid grid-cols-1 xl:grid-cols-12 gap-7">
                {/* Left 8 Cols: Exam Calendar Timeline */}
                <div className="xl:col-span-8 space-y-5">
                  <div className="flex items-center justify-between">
                    <h2 className="text-[16px] font-semibold text-[#1C1D21]">Exam Calendar</h2>
                    <button className="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#F4F5F8] text-[12px] font-medium">
                      <Filter className="w-3.5 h-3.5" />
                      <span>Filter</span>
                      <span className="w-4 h-4 rounded-full bg-[#1C1D21] text-white text-[10px] flex items-center justify-center">1</span>
                    </button>
                  </div>

                  {/* Month Selector Pills */}
                  <div className="flex items-center gap-2 overflow-x-auto pb-1">
                    {['Jan', 'Feb', 'March', 'April', 'May', 'June', 'Jul'].map((m) => (
                      <button
                        key={m}
                        onClick={() => setSelectedMonth(m)}
                        className={`px-4 py-1.5 rounded-full text-[12.5px] font-medium transition-all shrink-0 ${
                          selectedMonth === m ? 'bg-[#1C1D21] text-white' : 'bg-[#F4F5F8] text-[#6E717A] hover:text-[#1C1D21]'
                        }`}
                      >
                        {m}
                      </button>
                    ))}
                  </div>

                  {/* Day Rows */}
                  <div className="space-y-4">
                    {[1, 2, 3, 4, 5, 6].map((dayNum) => {
                      const dayExams = exams.filter(
                        (ex) =>
                          ex.day === dayNum &&
                          (ex.title.toLowerCase().includes(examSearch.toLowerCase()) ||
                            ex.classCode.includes(examSearch))
                      );
                      const isWeekend = dayNum === 4 || dayNum === 5;
                      return (
                        <div key={dayNum} className="flex items-start gap-4 pt-3 border-t border-black/[0.05]">
                          <div
                            className={`w-7 h-7 rounded-full flex items-center justify-center text-[12.5px] font-semibold shrink-0 ${
                              selectedCalendarDay === dayNum ? 'bg-[#1C1D21] text-white' : 'text-[#6E717A]'
                            }`}
                          >
                            {dayNum}
                          </div>

                          <div className="flex-1">
                            {isWeekend ? (
                              <div className="text-[13px] text-[#9496A1] py-1">Weekend</div>
                            ) : dayExams.length === 0 ? (
                              <div className="text-[13px] text-[#9496A1] py-1">No exam.</div>
                            ) : (
                              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                {dayExams.map((ex) => {
                                  const theme = PASTEL_THEMES[ex.theme] || PASTEL_THEMES.periwinkle;
                                  return (
                                    <div key={ex.id} className={`${theme.bg} rounded-[20px] p-3.5 space-y-3 border border-black/[0.03]`}>
                                      <div className="flex items-center gap-2.5">
                                        <span className="bg-white text-[#1C1D21] text-[11.5px] font-bold px-2.5 py-1 rounded-xl shadow-2xs">
                                          {ex.classCode}
                                        </span>
                                        <div>
                                          <div className="text-[12.5px] font-semibold text-[#1C1D21]">Class {ex.classCode}</div>
                                          <div className="text-[11px] text-[#6E717A]">{ex.time}</div>
                                        </div>
                                      </div>

                                      <div className="bg-white/90 rounded-2xl p-2.5 flex items-center gap-2.5">
                                        <div className={`w-7 h-7 rounded-lg ${theme.header} flex items-center justify-center ${theme.text}`}>
                                          <FileText className="w-3.5 h-3.5" />
                                        </div>
                                        <div>
                                          <div className="text-[12.5px] font-semibold text-[#1C1D21]">{ex.title}</div>
                                          <div className="text-[10.5px] text-[#8A8D98]">{ex.grade}</div>
                                        </div>
                                      </div>

                                      <div className="flex items-center justify-between text-[11px]">
                                        <span className="bg-white px-2.5 py-0.5 rounded-full font-medium text-[#146C43] flex items-center gap-1">
                                          <CheckCircle2 className="w-3 h-3 text-[#10B981]" /> {ex.status}
                                        </span>
                                        <span className="bg-white px-2 py-0.5 rounded-full font-semibold text-[#1C1D21]">
                                          {ex.students}
                                        </span>
                                      </div>
                                    </div>
                                  );
                                })}
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                {/* Right 4 Cols: Mini Calendar & Upcoming Exams */}
                <div className="xl:col-span-4 space-y-5">
                  <div className="bg-[#FAFBFD] rounded-[24px] p-5 border border-black/[0.04]">
                    <div className="flex items-center justify-between mb-4">
                      <span className="text-[14px] font-semibold text-[#1C1D21]">{selectedMonth} 2026</span>
                      <span className="text-[11.5px] font-medium text-[#6E717A]">{exams.length} Exams</span>
                    </div>
                    <div className="grid grid-cols-7 gap-1.5 text-center text-[12px]">
                      {Array.from({ length: 28 }, (_, i) => i + 1).map((d) => (
                        <button
                          key={d}
                          onClick={() => setSelectedCalendarDay(d)}
                          className={`h-8 rounded-full font-medium ${
                            selectedCalendarDay === d ? 'bg-[#1C1D21] text-white font-bold' : 'bg-white text-[#1C1D21] hover:bg-[#ECEBFF]'
                          }`}
                        >
                          {d}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div className="space-y-3">
                    <h3 className="text-[15px] font-semibold text-[#1C1D21]">Upcoming exams</h3>
                    {UPCOMING_EXAMS.map((item) => {
                      const theme = PASTEL_THEMES[item.theme];
                      return (
                        <div key={item.id} className={`${theme.bg} rounded-[20px] p-4 flex items-center justify-between`}>
                          <div className="flex items-center gap-3">
                            <span className="bg-white text-[#1C1D21] text-[12px] font-bold px-3 py-1.5 rounded-xl">
                              {item.classCode}
                            </span>
                            <div>
                              <div className="text-[13.5px] font-semibold text-[#1C1D21]">{item.title}</div>
                              <div className="text-[11px] text-[#6E717A]">{item.dateStr}</div>
                            </div>
                          </div>
                          <span className="bg-white text-[#1C1D21] text-[11px] font-semibold px-2.5 py-1 rounded-full">
                            {item.daysLeft}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* ================================================================
              VIEW: ASSIGNMENT MANAGEMENT
             ================================================================ */}
          {activePage === 'assignments' && (() => {
            const filteredAssignments = assignments.filter((a) => {
              const matchesStatus = assignmentFilterStatus === 'All' || a.status === assignmentFilterStatus;
              const matchesQuery =
                a.title.toLowerCase().includes(assignmentSearch.toLowerCase()) ||
                a.classCode.toLowerCase().includes(assignmentSearch.toLowerCase());
              return matchesStatus && matchesQuery;
            });
            const activeAssignment =
              assignments.find((a) => a.id === selectedAssignmentId) || filteredAssignments[0] || assignments[0];

            return (
              <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                  <div>
                    <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Assignment management</h1>
                    <p className="text-[13px] text-[#8A8D98] mt-0.5">
                      Create coursework, monitor student submissions, and grade assessments.
                    </p>
                  </div>

                  <div className="flex items-center gap-2.5">
                    <div className="relative">
                      <Search className="w-4 h-4 text-[#8A8D98] absolute left-3.5 top-1/2 -translate-y-1/2" />
                      <input
                        type="text"
                        value={assignmentSearch}
                        onChange={(e) => setAssignmentSearch(e.target.value)}
                        placeholder="Search assignments..."
                        className="pl-9 pr-4 py-2 rounded-full border border-black/[0.08] text-[13px] bg-white outline-none focus:border-[#1C1D21]"
                      />
                    </div>
                    <button
                      onClick={() => setIsNewAssignmentOpen(true)}
                      className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                    >
                      <Plus className="w-4 h-4" />
                      <span>Create assignment</span>
                    </button>
                  </div>
                </div>

                {/* Status Filter Pills */}
                <div className="flex flex-wrap items-center gap-2">
                  {['All', 'Active', 'Needs Grading', 'Completed'].map((st) => (
                    <button
                      key={st}
                      onClick={() => setAssignmentFilterStatus(st)}
                      className={`px-4 py-1.5 rounded-full text-[12.5px] font-medium transition-all ${
                        assignmentFilterStatus === st
                          ? 'bg-[#1C1D21] text-white'
                          : 'bg-[#F4F5F8] text-[#6E717A] hover:text-[#1C1D21]'
                      }`}
                    >
                      {st}
                    </button>
                  ))}
                </div>

                <div className="grid grid-cols-1 xl:grid-cols-12 gap-7">
                  {/* Left 7 Cols: Assignment Cards */}
                  <div className="xl:col-span-7 space-y-3.5">
                    {filteredAssignments.map((asg) => {
                      const theme = PASTEL_THEMES[asg.theme] || PASTEL_THEMES.periwinkle;
                      const pct = Math.round((asg.submitted / asg.total) * 100);
                      const isSelected = activeAssignment?.id === asg.id;
                      return (
                        <div
                          key={asg.id}
                          onClick={() => setSelectedAssignmentId(asg.id)}
                          className={`${theme.bg} rounded-[22px] p-5 cursor-pointer transition-all border-2 ${
                            isSelected ? 'border-[#1C1D21] shadow-sm' : 'border-transparent hover:-translate-y-0.5'
                          }`}
                        >
                          <div className="flex items-center justify-between gap-2">
                            <div className="flex items-center gap-2">
                              <span className="bg-white text-[#1C1D21] text-[11.5px] font-bold px-3 py-1 rounded-full">
                                {asg.classCode}
                              </span>
                              <span className="text-[12px] text-[#5A5D67]">{asg.subject}</span>
                            </div>
                            <span className="bg-white text-[#1C1D21] text-[11px] font-semibold px-3 py-1 rounded-full">
                              {asg.status}
                            </span>
                          </div>

                          <h3 className="text-[15.5px] font-semibold text-[#1C1D21] mt-3">{asg.title}</h3>

                          <div className="mt-4 space-y-1.5">
                            <div className="flex justify-between text-[11.5px] text-[#5A5D67]">
                              <span>Due: {asg.dueDate}</span>
                              <span className="font-semibold text-[#1C1D21]">
                                {asg.submitted}/{asg.total} Submitted ({pct}%)
                              </span>
                            </div>
                            <div className="w-full h-2 bg-white/75 rounded-full overflow-hidden">
                              <div className="h-full bg-[#1C1D21] rounded-full" style={{ width: `${pct}%` }} />
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  {/* Right 5 Cols: Submission Tracker & Grading */}
                  {activeAssignment && (
                    <div className="xl:col-span-5 bg-[#FAFBFD] rounded-[24px] p-6 border border-black/[0.04] space-y-4 self-start">
                      <div>
                        <span className="text-[11px] font-bold uppercase tracking-wider text-[#8A8D98]">
                          Submission Tracker
                        </span>
                        <h2 className="text-[16px] font-semibold text-[#1C1D21] mt-1">{activeAssignment.title}</h2>
                        <p className="text-[12px] text-[#6E717A]">{activeAssignment.classCode} · {activeAssignment.dueDate}</p>
                      </div>

                      <div className="space-y-2.5">
                        {activeAssignment.submissions.map((sub) => (
                          <div
                            key={sub.id}
                            className="bg-white p-3.5 rounded-2xl border border-black/[0.04] flex items-center justify-between gap-3"
                          >
                            <div className="flex items-center gap-3 min-w-0">
                              <span className={`w-8 h-8 rounded-full flex items-center justify-center text-[11px] font-bold shrink-0 ${sub.color}`}>
                                {sub.initials}
                              </span>
                              <div className="min-w-0">
                                <div className="text-[13px] font-semibold text-[#1C1D21] truncate">{sub.name}</div>
                                <div className="text-[11px] text-[#8A8D98]">{sub.time}</div>
                              </div>
                            </div>

                            {sub.status === 'Graded' ? (
                              <span className="px-3 py-1 rounded-full bg-[#E6F9F0] text-[#146C43] text-[12px] font-bold">
                                {sub.score}/100
                              </span>
                            ) : sub.status === 'Needs Review' ? (
                              <button
                                onClick={() => handleGradeSubmission(activeAssignment.id, sub.id, 91)}
                                className="px-3.5 py-1.5 rounded-full bg-[#1C1D21] text-white text-[11.5px] font-medium hover:bg-[#2E3036]"
                              >
                                Grade (91)
                              </button>
                            ) : (
                              <span className="px-2.5 py-1 rounded-full bg-[#F4F5F8] text-[#8A8D98] text-[11px] font-medium">
                                Pending
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })()}

          {/* ================================================================
              VIEW: SCHEDULE
             ================================================================ */}
          {activePage === 'schedule' && (
            <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                <div>
                  <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Schedule</h1>
                  <p className="text-[13px] text-[#8A8D98] mt-0.5">
                    Manage weekly teaching timetables, laboratory sessions, and classroom allocations.
                  </p>
                </div>

                <div className="flex items-center gap-2.5">
                  <select
                    value={scheduleClassFilter}
                    onChange={(e) => setScheduleClassFilter(e.target.value)}
                    className="px-3.5 py-2 rounded-full border border-black/[0.08] bg-white text-[12.5px] font-medium outline-none"
                  >
                    <option value="All">All Classes</option>
                    <option value="302">Class 302</option>
                    <option value="303">Class 303</option>
                    <option value="304">Class 304</option>
                    <option value="305">Class 305</option>
                  </select>
                  <button
                    onClick={() => setIsAddScheduleOpen(true)}
                    className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                  >
                    <Plus className="w-4 h-4" />
                    <span>Add Session</span>
                  </button>
                </div>
              </div>

              {/* Day Selector Pills */}
              <div className="grid grid-cols-5 gap-3">
                {[
                  { day: 'Mon', date: '09 Feb' },
                  { day: 'Tue', date: '10 Feb' },
                  { day: 'Wed', date: '11 Feb' },
                  { day: 'Thu', date: '12 Feb' },
                  { day: 'Fri', date: '13 Feb' },
                ].map((d) => {
                  const active = selectedScheduleDay === d.day;
                  return (
                    <button
                      key={d.day}
                      onClick={() => setSelectedScheduleDay(d.day)}
                      className={`p-3.5 rounded-[20px] text-center transition-all border ${
                        active
                          ? 'bg-[#1C1D21] text-white border-[#1C1D21] shadow-sm'
                          : 'bg-[#FAFBFD] text-[#1C1D21] border-black/[0.05] hover:bg-[#F4F5F8]'
                      }`}
                    >
                      <div className="text-[14px] font-bold">{d.day}</div>
                      <div className={`text-[11px] mt-0.5 ${active ? 'text-white/75' : 'text-[#8A8D98]'}`}>{d.date}</div>
                    </button>
                  );
                })}
              </div>

              {/* Day Timeline */}
              <div className="space-y-3.5">
                {schedules
                  .filter(
                    (s) =>
                      s.day === selectedScheduleDay &&
                      (scheduleClassFilter === 'All' || s.classCode === scheduleClassFilter)
                  )
                  .map((item) => {
                    const theme = PASTEL_THEMES[item.theme] || PASTEL_THEMES.periwinkle;
                    return (
                      <div
                        key={item.id}
                        className={`${theme.bg} rounded-[22px] p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-black/[0.03]`}
                      >
                        <div className="flex items-start sm:items-center gap-4">
                          <div className="bg-white px-3.5 py-2 rounded-2xl text-center shadow-2xs shrink-0">
                            <div className="text-[13px] font-bold text-[#1C1D21]">{item.startHour}</div>
                            <div className="text-[11px] text-[#8A8D98]">{item.endHour}</div>
                          </div>
                          <div>
                            <div className="flex items-center gap-2">
                              <span className="bg-white text-[#1C1D21] text-[11px] font-bold px-2.5 py-0.5 rounded-full">
                                Class {item.classCode}
                              </span>
                              <span className="text-[11.5px] font-medium text-[#5A5D67]">{item.type}</span>
                            </div>
                            <h3 className="text-[16px] font-semibold text-[#1C1D21] mt-1.5">{item.subject}</h3>
                            <div className="flex items-center gap-4 text-[12px] text-[#6E717A] mt-1">
                              <span className="flex items-center gap-1"><MapPin className="w-3.5 h-3.5" /> {item.room}</span>
                              <span className="flex items-center gap-1"><Users className="w-3.5 h-3.5" /> {item.students} students</span>
                            </div>
                          </div>
                        </div>

                        <div className="flex items-center gap-2 self-end sm:self-center">
                          <button
                            onClick={() => setActivePage('prep')}
                            className="px-3.5 py-2 rounded-full bg-white text-[#1C1D21] text-[12px] font-semibold hover:bg-white/80"
                          >
                            Lesson Plan
                          </button>
                          <button
                            onClick={() => setActivePage('attendance')}
                            className="px-3.5 py-2 rounded-full bg-[#1C1D21] text-white text-[12px] font-semibold hover:bg-[#2E3036]"
                          >
                            Attendance
                          </button>
                        </div>
                      </div>
                    );
                  })}
              </div>
            </div>
          )}

          {/* ================================================================
              VIEW: STUDENTS DIRECTORY & ACADEMIC ROSTER
             ================================================================ */}
          {activePage === 'students' && (() => {
            const filteredStudents = studentsDirectory.filter((st) => {
              const matchesClass = studentClassFilter === 'All' || st.classCode === studentClassFilter;
              const matchesStatus = studentStatusFilter === 'All' || st.status === studentStatusFilter;
              const matchesSearch =
                st.name.toLowerCase().includes(studentSearchQuery.toLowerCase()) ||
                st.email.toLowerCase().includes(studentSearchQuery.toLowerCase()) ||
                st.classCode.toLowerCase().includes(studentSearchQuery.toLowerCase());
              return matchesClass && matchesStatus && matchesSearch;
            });

            return (
              <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
                {/* Header */}
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                  <div>
                    <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Students</h1>
                    <p className="text-[13px] text-[#8A8D98] mt-0.5">
                      Manage enrolled student profiles, attendance records, academic averages, and guardian contacts.
                    </p>
                  </div>

                  <div className="flex flex-wrap items-center gap-2.5">
                    <div className="relative">
                      <Search className="w-4 h-4 text-[#8A8D98] absolute left-3.5 top-1/2 -translate-y-1/2" />
                      <input
                        type="text"
                        value={studentSearchQuery}
                        onChange={(e) => setStudentSearchQuery(e.target.value)}
                        placeholder="Search student or email..."
                        className="pl-9 pr-4 py-2 rounded-full border border-black/[0.08] text-[13px] bg-white outline-none focus:border-[#1C1D21]"
                      />
                    </div>
                    <button
                      onClick={() => setIsAddStudentOpen(true)}
                      className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                    >
                      <Plus className="w-4 h-4" />
                      <span>Add Student</span>
                    </button>
                  </div>
                </div>

                {/* 4 Pastel Summary Cards */}
                <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                  <div className="bg-[#ECEBFF] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#3F3B99]">Total Enrolled</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">{studentsDirectory.length} Students</div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Across Classes 302 – 305</p>
                  </div>
                  <div className="bg-[#E6F9F0] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#146C43]">Honor Roll</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">
                      {studentsDirectory.filter((s) => s.status === 'Honor Roll').length} Students
                    </div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Mean score 90% and above</p>
                  </div>
                  <div className="bg-[#FFF5E6] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#8C5811]">Avg Attendance</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">
                      {Math.round(studentsDirectory.reduce((acc, s) => acc + s.rate, 0) / studentsDirectory.length)}%
                    </div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Consistent term participation</p>
                  </div>
                  <div className="bg-[#FFECEB] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#942922]">Needs Support</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">
                      {studentsDirectory.filter((s) => s.status === 'Needs Support').length} Student
                    </div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Scheduled for advisor follow-up</p>
                  </div>
                </div>

                {/* Filter Bar */}
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div className="flex flex-wrap items-center gap-1.5 bg-[#F4F5F8] p-1 rounded-full border border-black/[0.04]">
                    {['All', 'Class 302', 'Class 303', 'Class 304', 'Class 305'].map((cls) => (
                      <button
                        key={cls}
                        onClick={() => setStudentClassFilter(cls)}
                        className={`px-3.5 py-1.5 rounded-full text-[12px] font-medium transition-all ${
                          studentClassFilter === cls ? 'bg-[#1C1D21] text-white shadow-2xs' : 'text-[#6E717A] hover:text-[#1C1D21]'
                        }`}
                      >
                        {cls}
                      </button>
                    ))}
                  </div>

                  <div className="flex items-center gap-1.5">
                    {['All', 'Honor Roll', 'Active', 'Needs Support'].map((st) => (
                      <button
                        key={st}
                        onClick={() => setStudentStatusFilter(st)}
                        className={`px-3 py-1.5 rounded-full text-[11.5px] font-semibold transition-all border ${
                          studentStatusFilter === st
                            ? 'bg-[#ECEBFF] text-[#3F3B99] border-[#C5C2FF]'
                            : 'bg-white text-[#6E717A] border-black/[0.06] hover:text-[#1C1D21]'
                        }`}
                      >
                        {st}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Students Card Grid */}
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  {filteredStudents.map((st) => {
                    const statusBadge =
                      st.status === 'Honor Roll'
                        ? 'bg-[#E6F9F0] text-[#146C43]'
                        : st.status === 'Needs Support'
                        ? 'bg-[#FFECEB] text-[#942922]'
                        : 'bg-[#ECEBFF] text-[#3F3B99]';
                    return (
                      <div
                        key={st.id}
                        onClick={() => setSelectedStudentDrawer(st)}
                        className="bg-[#FAFBFD] hover:bg-white rounded-[22px] p-5 border border-black/[0.05] hover:shadow-sm transition-all cursor-pointer space-y-4"
                      >
                        <div className="flex items-start justify-between gap-3">
                          <div className="flex items-center gap-3 min-w-0">
                            <span className={`w-11 h-11 rounded-full flex items-center justify-center text-[13px] font-bold shrink-0 ${st.color}`}>
                              {st.initials}
                            </span>
                            <div className="min-w-0">
                              <h3 className="text-[15px] font-semibold text-[#1C1D21] truncate">{st.name}</h3>
                              <p className="text-[11.5px] text-[#8A8D98] truncate">{st.email}</p>
                            </div>
                          </div>
                          <span className={`px-2.5 py-0.5 rounded-full text-[10.5px] font-semibold shrink-0 ${statusBadge}`}>
                            {st.status}
                          </span>
                        </div>

                        <div className="flex items-center justify-between text-[12px] bg-white px-3.5 py-2.5 rounded-2xl border border-black/[0.04]">
                          <div>
                            <div className="text-[10.5px] text-[#8A8D98]">Class</div>
                            <div className="font-semibold text-[#1C1D21]">{st.classCode}</div>
                          </div>
                          <div>
                            <div className="text-[10.5px] text-[#8A8D98]">Attendance</div>
                            <div className="font-semibold text-[#146C43]">{st.rate}%</div>
                          </div>
                          <div>
                            <div className="text-[10.5px] text-[#8A8D98]">Mean Score</div>
                            <div className="font-bold text-[#1C1D21]">{st.score}%</div>
                          </div>
                        </div>

                        <div className="flex items-center justify-between text-[11.5px] text-[#6E717A] pt-1">
                          <span>Guardian: <strong className="text-[#1C1D21] font-medium">{st.guardian}</strong></span>
                          <span className="text-[#3F3B99] font-semibold flex items-center gap-0.5">
                            Profile <ChevronRight className="w-3.5 h-3.5" />
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })()}

          {/* ================================================================
              VIEW: MESSAGES INBOX & DIRECT CHAT
             ================================================================ */}
          {activePage === 'messages' && (() => {
            const filteredThreads = messagesThreads.filter((t) => {
              const matchesTab = messageFilterTab === 'All' || t.unread;
              const matchesQuery =
                t.sender.toLowerCase().includes(messageSearch.toLowerCase()) ||
                t.subject.toLowerCase().includes(messageSearch.toLowerCase()) ||
                t.role.toLowerCase().includes(messageSearch.toLowerCase());
              return matchesTab && matchesQuery;
            });
            const activeThread =
              messagesThreads.find((t) => t.id === selectedThreadId) || filteredThreads[0] || messagesThreads[0];

            return (
              <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
                {/* Header */}
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                  <div>
                    <div className="flex items-center gap-2.5">
                      <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Messages</h1>
                      {unreadMessagesCount > 0 && (
                        <span className="px-2.5 py-0.5 rounded-full bg-[#FFECEB] text-[#942922] text-[11.5px] font-bold">
                          {unreadMessagesCount} Unread
                        </span>
                      )}
                    </div>
                    <p className="text-[13px] text-[#8A8D98] mt-0.5">
                      Direct communication with parents, guardians, and academic coordinators.
                    </p>
                  </div>

                  <div className="flex items-center gap-2.5">
                    <button
                      onClick={() => {
                        setMessagesThreads((prev) => prev.map((t) => ({ ...t, unread: false })));
                        triggerToast('Inbox Updated', 'All conversations marked as read.', 'success');
                      }}
                      className="px-4 py-2.5 rounded-full border border-black/[0.08] text-[12.5px] font-medium text-[#1C1D21] hover:bg-[#F4F5F8] transition-colors"
                    >
                      Mark all read
                    </button>
                    <button
                      onClick={() => setIsComposeMessageOpen(true)}
                      className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                    >
                      <Plus className="w-4 h-4" />
                      <span>New Message</span>
                    </button>
                  </div>
                </div>

                {/* 12-Col Chat Workspace */}
                <div className="grid grid-cols-1 xl:grid-cols-12 gap-6 items-stretch">
                  {/* Left 5 Cols: Thread List */}
                  <div className="xl:col-span-5 bg-[#FAFBFD] rounded-[24px] p-4 border border-black/[0.04] space-y-3">
                    <div className="flex items-center gap-2">
                      <div className="relative flex-1">
                        <Search className="w-3.5 h-3.5 text-[#8A8D98] absolute left-3.5 top-1/2 -translate-y-1/2" />
                        <input
                          type="text"
                          value={messageSearch}
                          onChange={(e) => setMessageSearch(e.target.value)}
                          placeholder="Search sender or subject..."
                          className="w-full pl-9 pr-3 py-2 rounded-full bg-white border border-black/[0.07] text-[12.5px] outline-none focus:border-[#1C1D21]"
                        />
                      </div>
                      <div className="flex bg-white p-1 rounded-full border border-black/[0.06]">
                        {['All', 'Unread'].map((tab) => (
                          <button
                            key={tab}
                            onClick={() => setMessageFilterTab(tab)}
                            className={`px-3 py-1 rounded-full text-[11px] font-semibold transition-all ${
                              messageFilterTab === tab ? 'bg-[#1C1D21] text-white' : 'text-[#6E717A]'
                            }`}
                          >
                            {tab}
                          </button>
                        ))}
                      </div>
                    </div>

                    <div className="space-y-2 max-h-[500px] overflow-y-auto pr-1">
                      {filteredThreads.map((thread) => {
                        const isSelected = activeThread?.id === thread.id;
                        const lastMsg = thread.messages[thread.messages.length - 1];
                        return (
                          <button
                            key={thread.id}
                            onClick={() => handleSelectThread(thread.id)}
                            className={`w-full text-left p-3.5 rounded-[20px] transition-all border ${
                              isSelected
                                ? 'bg-white border-[#1C1D21] shadow-xs'
                                : thread.unread
                                ? 'bg-[#ECEBFF]/60 border-[#C5C2FF]/60 hover:bg-white'
                                : 'bg-white/70 border-black/[0.04] hover:bg-white'
                            }`}
                          >
                            <div className="flex items-start justify-between gap-2.5">
                              <div className="flex items-center gap-3 min-w-0">
                                <div className="relative shrink-0">
                                  <span className={`w-10 h-10 rounded-full flex items-center justify-center text-[12px] font-bold ${thread.color}`}>
                                    {thread.initials}
                                  </span>
                                  {thread.online && (
                                    <span className="w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-white absolute bottom-0 right-0" />
                                  )}
                                </div>
                                <div className="min-w-0">
                                  <div className="flex items-center gap-1.5">
                                    <span className="text-[13.5px] font-semibold text-[#1C1D21] truncate">{thread.sender}</span>
                                    {thread.unread && <span className="w-2 h-2 rounded-full bg-[#7A74FF] shrink-0" />}
                                  </div>
                                  <div className="text-[11px] text-[#8A8D98] truncate">{thread.role}</div>
                                </div>
                              </div>
                              <span className="text-[10.5px] text-[#8A8D98] shrink-0">{thread.time}</span>
                            </div>

                            <div className="mt-2.5">
                              <div className="text-[12px] font-semibold text-[#1C1D21] truncate">{thread.subject}</div>
                              <p className="text-[11.5px] text-[#6E717A] truncate mt-0.5">
                                {lastMsg?.fromMe ? `You: ${lastMsg.text}` : lastMsg?.text}
                              </p>
                            </div>
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  {/* Right 7 Cols: Active Conversation Thread */}
                  {activeThread && (
                    <div className="xl:col-span-7 bg-[#FAFBFD] rounded-[24px] border border-black/[0.04] flex flex-col justify-between overflow-hidden min-h-[480px]">
                      {/* Conversation Top Bar */}
                      <div className="bg-white px-5 py-4 border-b border-black/[0.05] flex items-center justify-between gap-3">
                        <div className="flex items-center gap-3 min-w-0">
                          <span className={`w-10 h-10 rounded-full flex items-center justify-center text-[12px] font-bold shrink-0 ${activeThread.color}`}>
                            {activeThread.initials}
                          </span>
                          <div className="min-w-0">
                            <div className="text-[14.5px] font-semibold text-[#1C1D21] truncate">{activeThread.sender}</div>
                            <div className="text-[11.5px] text-[#8A8D98] truncate">{activeThread.role} · {activeThread.subject}</div>
                          </div>
                        </div>
                        <span className="px-3 py-1 rounded-full bg-[#E6F9F0] text-[#146C43] text-[11px] font-semibold shrink-0">
                          {activeThread.online ? 'Online' : 'Offline'}
                        </span>
                      </div>

                      {/* Message Bubbles */}
                      <div className="flex-1 p-5 space-y-3 overflow-y-auto max-h-[340px]">
                        {activeThread.messages.map((m) => (
                          <div key={m.id} className={`flex flex-col ${m.fromMe ? 'items-end' : 'items-start'}`}>
                            <div
                              className={`max-w-[82%] px-4 py-3 rounded-[20px] text-[13px] leading-relaxed ${
                                m.fromMe
                                  ? 'bg-[#1C1D21] text-white rounded-br-md'
                                  : 'bg-white text-[#1C1D21] border border-black/[0.05] rounded-bl-md shadow-2xs'
                              }`}
                            >
                              {m.text}
                            </div>
                            <span className="text-[10px] text-[#8A8D98] mt-1 px-1">{m.time}</span>
                          </div>
                        ))}
                      </div>

                      {/* Reply Input Bar */}
                      <form onSubmit={handleSendMessageReply} className="bg-white p-3.5 border-t border-black/[0.05] flex items-center gap-2.5">
                        <input
                          type="text"
                          value={messageDraft}
                          onChange={(e) => setMessageDraft(e.target.value)}
                          placeholder={`Reply to ${activeThread.sender}...`}
                          className="flex-1 bg-[#F4F5F8] rounded-full px-4 py-2.5 text-[13px] outline-none focus:bg-white focus:ring-2 focus:ring-[#1C1D21]/10"
                        />
                        <button
                          type="submit"
                          className="px-5 py-2.5 rounded-full bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium transition-all cursor-pointer shrink-0"
                        >
                          Send
                        </button>
                      </form>
                    </div>
                  )}
                </div>
              </div>
            );
          })()}

          {/* ================================================================
              VIEW: REPORTS & ACADEMIC EXPORTS
             ================================================================ */}
          {activePage === 'reports' && (() => {
            const filteredReports = reportsList.filter(
              (r) => reportCategoryFilter === 'All' || r.category === reportCategoryFilter
            );
            const activeReport =
              reportsList.find((r) => r.id === selectedReportId) || filteredReports[0] || reportsList[0];

            return (
              <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
                {/* Header */}
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                  <div>
                    <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Reports</h1>
                    <p className="text-[13px] text-[#8A8D98] mt-0.5">
                      Generate, preview, and export official academic transcripts, attendance audits, and rubric summaries.
                    </p>
                  </div>

                  <div className="flex items-center gap-2.5">
                    <button
                      onClick={() => activeReport && handleDownloadReportCsv(activeReport)}
                      className="flex items-center gap-2 px-4 py-2.5 rounded-full border border-black/[0.08] text-[13px] font-medium text-[#1C1D21] hover:bg-[#F4F5F8] transition-colors"
                    >
                      <Download className="w-4 h-4" />
                      <span>Quick CSV</span>
                    </button>
                    <button
                      onClick={() => setIsGenerateReportOpen(true)}
                      className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all cursor-pointer"
                    >
                      <Plus className="w-4 h-4" />
                      <span>Generate Report</span>
                    </button>
                  </div>
                </div>

                {/* 3 Pastel Summary KPI Cards */}
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div className="bg-[#ECEBFF] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#3F3B99]">Compiled Reports</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">{reportsList.length} Documents</div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Term 1 · Academic Year 2026</p>
                  </div>
                  <div className="bg-[#E6F9F0] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#146C43]">Verified Gradebooks</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">4 / 4 Classes</div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">100% assessment records synced</p>
                  </div>
                  <div className="bg-[#FFF5E6] rounded-[22px] p-5 border border-black/[0.03]">
                    <span className="text-[12px] font-semibold text-[#8C5811]">Export Formats</span>
                    <div className="text-[26px] font-bold text-[#1C1D21] mt-2">PDF & CSV</div>
                    <p className="text-[11.5px] text-[#5A5D67] mt-1">Ready for faculty & parent distribution</p>
                  </div>
                </div>

                {/* Category Filter Pills */}
                <div className="flex flex-wrap items-center gap-2">
                  {['All', 'Academic', 'Attendance', 'Assessments', 'Advisory'].map((cat) => (
                    <button
                      key={cat}
                      onClick={() => setReportCategoryFilter(cat)}
                      className={`px-4 py-1.5 rounded-full text-[12.5px] font-medium transition-all ${
                        reportCategoryFilter === cat
                          ? 'bg-[#1C1D21] text-white'
                          : 'bg-[#F4F5F8] text-[#6E717A] hover:text-[#1C1D21]'
                      }`}
                    >
                      {cat}
                    </button>
                  ))}
                </div>

                {/* 12-Col Layout: Left Report Cards (7 Cols) | Right Document Preview & Download (5 Cols) */}
                <div className="grid grid-cols-1 xl:grid-cols-12 gap-7">
                  <div className="xl:col-span-7 space-y-3.5">
                    {filteredReports.map((rep) => {
                      const theme = PASTEL_THEMES[rep.theme] || PASTEL_THEMES.periwinkle;
                      const isSelected = activeReport?.id === rep.id;
                      return (
                        <div
                          key={rep.id}
                          onClick={() => setSelectedReportId(rep.id)}
                          className={`${theme.bg} rounded-[22px] p-5 cursor-pointer transition-all border-2 ${
                            isSelected ? 'border-[#1C1D21] shadow-sm' : 'border-transparent hover:-translate-y-0.5'
                          }`}
                        >
                          <div className="flex items-center justify-between gap-2">
                            <div className="flex items-center gap-2">
                              <span className="bg-white text-[#1C1D21] text-[11px] font-bold px-3 py-1 rounded-full">
                                {rep.classCode}
                              </span>
                              <span className="text-[12px] font-semibold text-[#5A5D67]">{rep.category}</span>
                            </div>
                            <span className="bg-white text-[#1C1D21] text-[11px] font-semibold px-3 py-1 rounded-full">
                              {rep.format}
                            </span>
                          </div>

                          <h3 className="text-[16px] font-semibold text-[#1C1D21] mt-3">{rep.title}</h3>
                          <p className="text-[12px] text-[#5A5D67] mt-1 line-clamp-2">{rep.summary}</p>

                          <div className="flex items-center justify-between text-[11.5px] text-[#6E717A] mt-3 pt-2.5 border-t border-black/[0.05]">
                            <span>Generated: {rep.generatedDate}</span>
                            <span className="font-semibold text-[#1C1D21]">Mean Score: {rep.metrics.avgScore}</span>
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  {/* Right 5 Cols: Report Preview Inspector */}
                  {activeReport && (
                    <div className="xl:col-span-5 bg-[#FAFBFD] rounded-[24px] p-6 border border-black/[0.04] space-y-5 self-start">
                      <div className="flex items-start justify-between gap-2">
                        <div>
                          <span className="text-[11px] font-bold uppercase tracking-wider text-[#8A8D98]">
                            Report Document Preview
                          </span>
                          <h2 className="text-[17px] font-semibold text-[#1C1D21] mt-1">{activeReport.title}</h2>
                          <p className="text-[12px] text-[#6E717A] mt-0.5">
                            {activeReport.classCode} · {activeReport.format} · {activeReport.generatedDate}
                          </p>
                        </div>
                        <span className="px-3 py-1 rounded-full bg-[#E6F9F0] text-[#146C43] text-[11px] font-bold">
                          {activeReport.status}
                        </span>
                      </div>

                      <div className="grid grid-cols-3 gap-2.5 text-center">
                        <div className="bg-white p-3 rounded-2xl border border-black/[0.04]">
                          <div className="text-[10.5px] text-[#8A8D98]">Mean Score</div>
                          <div className="text-[16px] font-bold text-[#1C1D21] mt-0.5">{activeReport.metrics.avgScore}</div>
                        </div>
                        <div className="bg-white p-3 rounded-2xl border border-black/[0.04]">
                          <div className="text-[10.5px] text-[#8A8D98]">Attendance</div>
                          <div className="text-[16px] font-bold text-[#146C43] mt-0.5">{activeReport.metrics.attendance}</div>
                        </div>
                        <div className="bg-white p-3 rounded-2xl border border-black/[0.04]">
                          <div className="text-[10.5px] text-[#8A8D98]">Pass Rate</div>
                          <div className="text-[16px] font-bold text-[#3F3B99] mt-0.5">{activeReport.metrics.passRate}</div>
                        </div>
                      </div>

                      <div className="bg-white p-4 rounded-2xl border border-black/[0.04] space-y-2">
                        <div className="text-[12px] font-semibold text-[#1C1D21]">Executive Summary</div>
                        <p className="text-[12.5px] text-[#5A5D67] leading-relaxed">{activeReport.summary}</p>
                        <div className="text-[11px] text-[#8A8D98] pt-2 border-t border-black/[0.05]">
                          Prepared by: <strong className="text-[#1C1D21]">Rasengan</strong> · Servolution Faculty
                        </div>
                      </div>

                      <div className="flex gap-2.5">
                        <button
                          onClick={() => handleDownloadReportCsv(activeReport)}
                          className="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-full bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium transition-all cursor-pointer"
                        >
                          <Download className="w-4 h-4" />
                          <span>Download CSV</span>
                        </button>
                        <button
                          onClick={() => window.print()}
                          className="px-4 py-2.5 rounded-full border border-black/[0.1] bg-white text-[#1C1D21] text-[13px] font-medium hover:bg-[#F4F5F8] transition-colors"
                        >
                          Print PDF
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })()}

          {/* ================================================================
              VIEW: UI DESIGN SYSTEM EXPLORER (JAMPACK STRUCTURE + 1 PDF)
             ================================================================ */}
          {activePage === 'uikit' && (() => {
            const JAMPACK_TREE = [
              {
                id: 'utilities',
                label: '1. Utilities',
                badge: '12',
                items: ['Grid', 'Typography', 'Background', 'Border', 'Color', 'Shadow', 'Sizing', 'Spacing', 'Shapes', 'Seperators', 'Media Objects', 'Embeds', 'Images', 'Icon Fonts']
              },
              {
                id: 'datadisplay',
                label: '2. Data Display',
                badge: '15',
                items: ['Avatar', 'Accordion', 'Badges', 'Advance Badges', 'Tooltip', 'Popovers', 'Modal', 'Cards', 'Carousel', 'Collapse', 'List Group', 'Ribbon', 'Drawers', 'Offcanvas', 'Empty States', 'Callout', 'Gallery']
              },
              {
                id: 'dataentry',
                label: '3. Data Entry',
                badge: '16',
                items: ['Buttons', 'Form Elements', 'Input Groups', 'Form Layout', 'Form Mask', 'Form Validation', 'Advance Form UI', 'Cropperjs', 'Dropzone', 'Date Picker', 'Color Picker', 'React Select', 'Range Slider', 'Input Spinner', 'Form Wizard', 'Tinymce', 'Chips', 'Ratings', 'Page Search']
              },
              {
                id: 'feedback',
                label: '4. Feedback',
                badge: '11',
                items: ['Sweet Alert', 'Notifications', 'Toast Alerts', 'Tour', 'Timeout', 'Alerts', 'Placeholders', 'Spinners', 'Progress', 'Bootstrap Toast', 'Clipboard']
              },
              {
                id: 'tables',
                label: '5. Tables',
                badge: '3',
                items: ['Basic Tables', 'Data Tables', 'Advance Table UI']
              },
              {
                id: 'charts',
                label: '6. Charts',
                badge: '1',
                items: ['Charts']
              },
              {
                id: 'maps',
                label: '7. Maps',
                badge: '3',
                items: ['Google Maps', 'Vector Maps', 'Animated Maps']
              },
              {
                id: 'navigation',
                label: '8. Navigation',
                badge: '7',
                items: ['Breadcrumbs', 'Dropdowns', 'Nav', 'Tabs', 'Wizard', 'Pagination', 'Toolbar']
              },
              {
                id: 'behavioral',
                label: '9. Behavioral',
                badge: '6',
                items: ['Scroll Spy', 'Sticky Elements', 'Draggable', 'Scrollable Content', 'Fixed Footer', 'Load More']
              },
              {
                id: 'layout',
                label: '10. Layout',
                badge: '4',
                items: ['Menus', 'Navbar', 'Page Headers', 'Page Footers']
              }
            ];

            const handleSelectJampackNode = (groupId, subLabel = '') => {
              setUiCategory(groupId);
              setUiSubJump(subLabel);
              if (subLabel) {
                triggerToast(
                  JAMPACK_TREE.find((g) => g.id === groupId)?.label || 'UI Kit',
                  `Menampilkan komponen: ${subLabel}`,
                  'info'
                );
              }
            };

            return (
              <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
                {/* Header Bar */}
                <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-black/[0.05]">
                  <div>
                    <div className="flex items-center gap-2">
                      <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Servolution UI Design System</h1>
                      <span className="px-2.5 py-0.5 rounded-full bg-[#ECEBFF] text-[#3F3B99] text-[11px] font-bold">
                        Struktur Jampack
                      </span>
                    </div>
                    <p className="text-[13px] text-[#8A8D98] mt-0.5">
                      Disusun berurutan sesuai struktur dokumentasi Jampack: Utilities → Data Display → Data Entry → Feedback → Tables → Charts → Maps → Navigation → Behavioral → Layout.
                    </p>
                  </div>

                  <div className="flex flex-wrap items-center gap-2.5 no-print">
                    <button
                      onClick={() => {
                        setUiCategory('all');
                        setUiSubJump('');
                      }}
                      className={`px-4 py-2 rounded-full text-[12.5px] font-medium transition-all ${
                        uiCategory === 'all'
                          ? 'bg-[#1C1D21] text-white shadow-2xs'
                          : 'bg-[#F4F5F8] text-[#5A5D67] hover:text-[#1C1D21]'
                      }`}
                    >
                      Tampilkan Semua (1–10)
                    </button>

                    <button
                      onClick={handleExportUiKitPdf}
                      className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[12.5px] font-medium px-4 py-2 rounded-full shadow-xs transition-all cursor-pointer"
                    >
                      <Download className="w-3.5 h-3.5" />
                      <span>Export 1 PDF</span>
                    </button>
                  </div>
                </div>

                {/* 2-Column Layout: Left Jampack Index Tree (3 Cols) | Right Component Showcase (9 Cols) */}
                <div className="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
                  {/* Left Directory Sidebar (Jampack Order) */}
                  <div className="xl:col-span-3 bg-[#FAFBFD] rounded-[24px] p-4 border border-black/[0.05] space-y-2 xl:sticky xl:top-0 no-print">
                    <div className="flex items-center justify-between px-2 pb-1.5 border-b border-black/[0.05]">
                      <span className="text-[11.5px] font-bold uppercase tracking-wider text-[#8A8D98]">
                        Daftar Isi UI Kit
                      </span>
                      <span className="text-[10.5px] font-semibold text-[#3F3B99]">10 Grup</span>
                    </div>

                    <div className="space-y-1.5 max-h-[72vh] overflow-y-auto pr-1">
                      {JAMPACK_TREE.map((group) => {
                        const isGroupActive = uiCategory === group.id;
                        return (
                          <div key={group.id} className="rounded-2xl overflow-hidden">
                            <button
                              onClick={() => handleSelectJampackNode(isGroupActive ? 'all' : group.id, '')}
                              className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-[12.5px] font-semibold transition-all ${
                                isGroupActive
                                  ? 'bg-[#1C1D21] text-white shadow-2xs'
                                  : 'text-[#1C1D21] hover:bg-white'
                              }`}
                            >
                              <span>{group.label}</span>
                              <span
                                className={`text-[10px] px-2 py-0.5 rounded-full font-bold ${
                                  isGroupActive ? 'bg-white/20 text-white' : 'bg-[#ECEBFF] text-[#3F3B99]'
                                }`}
                              >
                                {group.items.length}
                              </span>
                            </button>

                            <div className="pl-3 pr-1 py-1.5 flex flex-wrap gap-1">
                              {group.items.map((sub) => {
                                const isSubActive = uiSubJump === sub && isGroupActive;
                                return (
                                  <button
                                    key={sub}
                                    onClick={() => handleSelectJampackNode(group.id, sub)}
                                    className={`px-2 py-0.5 rounded-full text-[10.5px] font-medium transition-colors ${
                                      isSubActive
                                        ? 'bg-[#7A74FF] text-white font-semibold'
                                        : 'bg-white text-[#6E717A] border border-black/[0.05] hover:border-[#1C1D21] hover:text-[#1C1D21]'
                                    }`}
                                  >
                                    {sub}
                                  </button>
                                );
                              })}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  {/* Right Showcase Canvas */}
                  <div className="xl:col-span-9 space-y-8 min-w-0">
                    {uiSubJump && (
                      <div className="bg-[#ECEBFF] border border-[#C5C2FF] rounded-2xl px-4 py-2.5 flex items-center justify-between no-print">
                        <div className="text-[12.5px] text-[#3F3B99]">
                          Fokus Kategori: <strong>{JAMPACK_TREE.find((g) => g.id === uiCategory)?.label}</strong> →{' '}
                          <span className="underline font-semibold">{uiSubJump}</span>
                        </div>
                        <button
                          onClick={() => {
                            setUiCategory('all');
                            setUiSubJump('');
                          }}
                          className="text-[11px] font-semibold px-3 py-1 rounded-full bg-white text-[#1C1D21]"
                        >
                          Reset Filter
                        </button>
                      </div>
                    )}

                    {/* ============================================================
                        1. UTILITIES (Grid, Typography, Background, Border, Color, Shadow, Sizing, Spacing, Shapes, Seperators, Media Objects, Embeds, Images, Icon Fonts)
                       ============================================================ */}
                    {(uiCategory === 'all' || uiCategory === 'utilities') && (
                      <div className="space-y-6 print-section">
                        <div className="bg-[#1C1D21] text-white rounded-[22px] px-5 py-3.5 flex items-center justify-between">
                          <div>
                            <span className="text-[10.5px] uppercase tracking-wider text-[#D6D4FF] font-bold">Section 01</span>
                            <h2 className="text-[18px] font-semibold">Utilities</h2>
                          </div>
                          <span className="text-[11.5px] text-white/75">
                            Grid · Typography · Background · Border · Color · Shadow · Sizing · Spacing · Shapes · Seperators · Media · Embeds · Images · Icons
                          </span>
                        </div>

                        {/* 1.1 Grid & Design Tokens */}
                        <div className="space-y-4">
                          <div className="flex items-center justify-between">
                            <h3 className="text-[15px] font-semibold text-[#1C1D21]">
                              1.1 Grid (Grid System, Basic Structure, Mix & Match, Gutters, Reordering & Row Column)
                            </h3>
                            <span className="text-[11px] font-semibold px-3 py-1 rounded-full bg-[#ECEBFF] text-[#3F3B99]">Utilities · Grid</span>
                          </div>

                          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3.5">
                            <div className="bg-[#ECEBFF] rounded-[20px] p-4 border border-[#C5C2FF]">
                              <div className="text-[12px] font-bold text-[#3F3B99]">Periwinkle Surface</div>
                              <div className="text-[11px] text-[#5A5D67] mt-1">BG: #ECEBFF · Header: #D6D4FF</div>
                            </div>
