              <Clock className="w-5 h-5" />
              <h3 className="text-[16px] font-bold text-[#1C1D21]">Session Timeout Warning</h3>
            </div>
            <p className="text-[12.5px] text-[#6E717A]">
              Your Servolution session will automatically lock in <strong>00:59</strong> due to inactivity.
            </p>
            <div className="flex gap-2 pt-2">
              <button
                onClick={() => setUiSessionModal(false)}
                className="flex-1 py-2 rounded-full border border-black/[0.1] text-[12.5px] font-medium"
              >
                Logout
              </button>
              <button
                onClick={() => {
                  setUiSessionModal(false);
                  triggerToast('Session Extended', 'Stay logged in for another 60 minutes.', 'success');
                }}
                className="flex-1 py-2 rounded-full bg-[#1C1D21] text-white text-[12.5px] font-medium"
              >
                Stay Connected
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}