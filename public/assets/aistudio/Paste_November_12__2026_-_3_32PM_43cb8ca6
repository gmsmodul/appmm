  ]);
  const [selectedThreadId, setSelectedThreadId] = useState('MSG-01');
  const [messageSearch, setMessageSearch] = useState('');
  const [messageFilterTab, setMessageFilterTab] = useState('All');
  const [messageDraft, setMessageDraft] = useState('');
  const [isComposeMessageOpen, setIsComposeMessageOpen] = useState(false);
  const [composeForm, setComposeForm] = useState({
    recipient: 'Claire Carter (Parent · Class 302)',
    subject: 'Mid-Term Progress Update',
    body: ''
  });

  const unreadMessagesCount = messagesThreads.filter((t) => t.unread).length;

  const handleSelectThread = (threadId) => {
    setSelectedThreadId(threadId);
    setMessagesThreads((prev) =>
      prev.map((t) => (t.id === threadId ? { ...t, unread: false } : t))
    );
  };

  const handleSendMessageReply = (e) => {
    e.preventDefault();
    if (!messageDraft.trim()) return;
    setMessagesThreads((prev) =>
      prev.map((t) => {
        if (t.id !== selectedThreadId) return t;
        return {
          ...t,
          unread: false,
          time: 'Just now',
          messages: [
            ...t.messages,
            { id: 'm-' + Date.now(), fromMe: true, text: messageDraft.trim(), time: 'Just now' }
          ]
        };
      })
    );
    setMessageDraft('');
    triggerToast('Message Sent', 'Your reply has been delivered.', 'success');
  };

  const handleComposeNewMessage = (e) => {
    e.preventDefault();
    if (!composeForm.body.trim()) return;
    const parts = composeForm.recipient.split(' ');
    const initials = (parts[0]?.[0] || 'M') + (parts[1]?.[0] || 'S');
    const createdThread = {
      id: 'MSG-' + Date.now(),
      sender: composeForm.recipient.split('(')[0].trim(),
      role: composeForm.recipient,
      initials: initials.toUpperCase(),
      color: 'bg-[#D6D4FF] text-[#3F3B99]',
      time: 'Just now',
      unread: false,
      online: true,
      subject: composeForm.subject,
      messages: [
        { id: 'm-' + Date.now(), fromMe: true, text: composeForm.body.trim(), time: 'Just now' }
      ]
    };
    setMessagesThreads((prev) => [createdThread, ...prev]);
    setSelectedThreadId(createdThread.id);
    setComposeForm({ recipient: 'Claire Carter (Parent · Class 302)', subject: 'Mid-Term Progress Update', body: '' });
    setIsComposeMessageOpen(false);
    triggerToast('New Conversation Started', `Message sent to ${createdThread.sender}.`, 'success');
  };

