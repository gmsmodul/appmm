  const settingsMenu = [
    { id: 'uikit', label: 'UI Design System', icon: Layers, highlight: true },
    { id: 'news', label: 'School News', icon: Sparkles },
    { id: 'activities', label: 'School Activities', icon: Building2 },
    { id: 'whatsnew', label: "What's New", icon: Radio },
  ];

  const activePlan = lessonPlans.find(p => p.id === selectedPlanId) || lessonPlans[0];

  return (
    <div className="min-h-screen bg-[#E8E9ED] p-0 sm:p-3 md:p-5 font-sans text-[#1C1D21] flex justify-center items-stretch selection:bg-[#D6D4FF] selection:text-[#1C1D21]">
      {/* Global Print & Bottom Sheet Motion Styles */}
      <style>{`
        @keyframes sheetSlideUp {
          0% {
            transform: translateY(100%);
            opacity: 0.4;
          }
          100% {
            transform: translateY(0);
            opacity: 1;
          }
        }
        @keyframes modalFadeScale {
          0% {
            transform: scale(0.96) translateY(8px);
            opacity: 0;
          }
          100% {
            transform: scale(1) translateY(0);
            opacity: 1;
          }
        }
        .animate-bottom-sheet {
          animation: sheetSlideUp 0.34s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        @media (min-width: 640px) {
          .animate-bottom-sheet {
            animation: modalFadeScale 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
          }
        }
        @media print {
          @page {
            size: A4 landscape;
            margin: 10mm;
          }
          body {
            background: #FFFFFF !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
          }
          aside, header, .no-print {
            display: none !important;
          }
          main {
            margin: 0 !important;
            border: none !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            overflow: visible !important;
          }
          .print-section {
            break-inside: avoid;
            page-break-inside: avoid;
            margin-bottom: 18px;
          }
        }
      `}</style>

      {/* App Shell Container */}
      <div className="w-full max-w-[1440px] bg-gradient-to-br from-[#F4F3F8] via-[#F7F8FA] to-[#F2F5F4] sm:rounded-[28px] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.08)] border border-white/80 flex overflow-hidden relative">

        {/* Mobile Sidebar Overlay */}
        {mobileMenuOpen && (
          <div
            className="fixed inset-0 bg-black/30 backdrop-blur-xs z-40 lg:hidden"
            onClick={() => setMobileMenuOpen(false)}
          />
        )}

        {/* ==================================================================
            LEFT SIDEBAR
           ================================================================== */}
        <aside
          className={`fixed lg:static inset-y-0 left-0 z-50 flex flex-col justify-between transition-all duration-300 ease-out bg-[#F3F2F7]/95 lg:bg-transparent backdrop-blur-md border-r border-black/[0.04] ${
            sidebarOpen ? 'w-[260px]' : 'w-[84px]'
          } ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'} p-4 select-none`}
        >
          <div>
            {/* Brand Logo Header */}
            <div className="flex items-center justify-between px-2 pt-1 pb-6">
              <div className="flex items-center gap-3">
                <div className="w-9 h-9 rounded-full bg-[#1C1D21] flex items-center justify-center text-white shadow-sm shrink-0">
                  <div className="flex items-end gap-[2.5px] h-3.5">
                    <span className="w-[2.5px] h-2 bg-white rounded-full"></span>
                    <span className="w-[2.5px] h-3.5 bg-white rounded-full"></span>
                    <span className="w-[2.5px] h-2.5 bg-white rounded-full"></span>
                  </div>
                </div>
                {sidebarOpen && (
                  <span className="font-semibold text-[16px] tracking-tight text-[#1C1D21]">Servolution</span>
                )}
              </div>
              <button
                onClick={() => setSidebarOpen(!sidebarOpen)}
                title="Toggle Sidebar"
                className="hidden lg:flex w-8 h-8 rounded-lg hover:bg-black/5 items-center justify-center text-[#6E717A] transition-colors"
              >
                <PanelLeft className="w-4 h-4" />
              </button>
              <button
                onClick={() => setMobileMenuOpen(false)}
                className="lg:hidden w-8 h-8 rounded-lg hover:bg-black/5 flex items-center justify-center text-[#6E717A]"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Main Menu Group */}
            <div className="space-y-1">
              {sidebarOpen && (
                <div className="px-3 pb-1.5 text-[11px] font-medium text-[#9496A1] tracking-wide">
                  Main menu
                </div>
              )}
              {mainMenu.map((item) => {
                const Icon = item.icon;
                const isActive = activePage === item.id;
                return (
                  <button
                    key={item.id}
                    onClick={() => {
                      const supportedPages = ['overview', 'prep', 'attendance', 'exams', 'assignments', 'schedule', 'students', 'messages', 'analytics', 'reports'];
                      if (supportedPages.includes(item.id)) {
                        setActivePage(item.id);
                      } else {
                        setActivePage('uikit');
                        triggerToast('UI Design System', `Showing components used in ${item.label}`, 'info');
                      }
                      setMobileMenuOpen(false);
                    }}
                    className={`w-full flex items-center justify-between px-3 py-2.5 rounded-full text-[13.5px] transition-all duration-200 group ${
                      isActive
                        ? 'bg-white text-[#1C1D21] font-semibold shadow-[0_2px_10px_rgba(0,0,0,0.04)]'
                        : 'text-[#5A5D67] hover:bg-white/60 hover:text-[#1C1D21] font-medium'
                    }`}
                  >
                    <div className="flex items-center gap-3 min-w-0">
                      <Icon className={`w-[18px] h-[18px] shrink-0 ${isActive ? 'text-[#1C1D21]' : 'text-[#6E717A] group-hover:text-[#1C1D21]'}`} />
                      {sidebarOpen && <span className="truncate">{item.label}</span>}
                    </div>
                    {sidebarOpen && item.badge && (
                      item.isTag ? (
                        <span className="text-[10px] font-semibold bg-[#E4E5EC] text-[#6E717A] px-1.5 py-0.5 rounded-md">
                          {item.badge}
                        </span>
                      ) : (
                        <span className="w-5 h-5 rounded-full bg-[#1C1D21] text-white text-[11px] font-semibold flex items-center justify-center">
                          {item.badge}
                        </span>
                      )
                    )}
                  </button>
                );
              })}
            </div>

            {/* Settings & News Group */}
            <div className="mt-6 space-y-1">
              {sidebarOpen && (
                <div className="px-3 pb-1.5 text-[11px] font-medium text-[#9496A1] tracking-wide">
                  System & UI Kit
                </div>
              )}
              {settingsMenu.map((item) => {
                const Icon = item.icon;
                const isActive = activePage === item.id;
                return (
                  <button
                    key={item.id}
                    onClick={() => {
                      setActivePage('uikit');
                      setMobileMenuOpen(false);
                    }}
                    className={`w-full flex items-center justify-between px-3 py-2.5 rounded-full text-[13.5px] transition-all duration-200 ${
                      isActive
                        ? 'bg-[#1C1D21] text-white font-semibold shadow-sm'
                        : item.highlight
                        ? 'bg-[#ECEBFF] text-[#3F3B99] font-semibold hover:bg-[#DFDCFF]'
                        : 'text-[#5A5D67] hover:bg-white/60 hover:text-[#1C1D21] font-medium'
                    }`}
                  >
                    <div className="flex items-center gap-3 min-w-0">
                      <Icon className="w-[18px] h-[18px] shrink-0" />
                      {sidebarOpen && <span className="truncate">{item.label}</span>}
                    </div>
                    {sidebarOpen && item.highlight && !isActive && (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-white text-[#3F3B99] font-bold">
                        All UI
                      </span>
                    )}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Bottom Settings & Teacher Profile */}
          <div className="pt-4 border-t border-black/[0.05] space-y-3">
            <button
              onClick={() => setActivePage('uikit')}
              className="w-full flex items-center gap-3 px-3 py-2 rounded-full text-[13.5px] font-medium text-[#5A5D67] hover:bg-white/60 hover:text-[#1C1D21] transition-colors"
            >
              <Settings className="w-[18px] h-[18px] text-[#6E717A]" />
              {sidebarOpen && <span>Settings</span>}
            </button>

            <div className="px-2">
              {sidebarOpen && (
                <div className="text-[11px] font-medium text-[#9496A1] mb-2 px-1">Account</div>
              )}
              <div className="flex items-center gap-3 p-1.5 rounded-2xl hover:bg-white/70 transition-colors cursor-pointer">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80"
                  alt="Rasengan"
                  onError={(e) => {
                    e.currentTarget.src = 'https://placehold.co/80x80/1C1D21/FFFFFF?text=RS';
                  }}
                  className="w-9 h-9 rounded-full object-cover border border-white shadow-xs shrink-0"
                />
                {sidebarOpen && (
                  <div className="min-w-0">
                    <div className="text-[13px] font-semibold text-[#1C1D21] truncate">Rasengan</div>
                    <div className="text-[11px] text-[#8A8D98]">Teacher</div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </aside>

        {/* ==================================================================
            MAIN CONTENT WORKSPACE
           ================================================================== */}
        <main className="flex-1 bg-white sm:m-2.5 sm:rounded-[24px] shadow-[0_2px_20px_rgba(0,0,0,0.02)] border border-black/[0.03] flex flex-col min-w-0 overflow-hidden">

          {/* Top Breadcrumb & Action Navbar */}
          <header className="h-16 px-4 sm:px-7 border-b border-black/[0.05] flex items-center justify-between gap-4 shrink-0 bg-white/80 backdrop-blur-sm">
            <div className="flex items-center gap-3">
              <button
                onClick={() => setMobileMenuOpen(true)}
                className="lg:hidden p-2 rounded-xl hover:bg-[#F4F5F8] text-[#1C1D21]"
              >
                <Menu className="w-5 h-5" />
              </button>

              {/* Breadcrumbs */}
              <nav className="flex items-center gap-2 text-[13px]">
                <span className="text-[#9496A1] font-medium">Servolution</span>
                <ChevronRight className="w-3.5 h-3.5 text-[#B4B6C1]" />
                <div className="flex items-center gap-1.5 font-semibold text-[#1C1D21]">
                  {activePage === 'overview' && <><LayoutGrid className="w-4 h-4 text-[#1C1D21]" /> <span>Overview</span></>}
                  {activePage === 'prep' && <><BookOpen className="w-4 h-4 text-[#1C1D21]" /> <span>Class Preparation</span></>}
                  {activePage === 'attendance' && <><Clock className="w-4 h-4 text-[#1C1D21]" /> <span>Attendance</span></>}
                  {activePage === 'exams' && <><FileCheck className="w-4 h-4 text-[#1C1D21]" /> <span>Exams</span></>}
                  {activePage === 'assignments' && <><Bookmark className="w-4 h-4 text-[#1C1D21]" /> <span>Assignment management</span></>}
                  {activePage === 'schedule' && <><CalendarIcon className="w-4 h-4 text-[#1C1D21]" /> <span>Schedule</span></>}
                  {activePage === 'students' && <><Users className="w-4 h-4 text-[#1C1D21]" /> <span>Students</span></>}
                  {activePage === 'messages' && <><Mail className="w-4 h-4 text-[#1C1D21]" /> <span>Messages</span></>}
                  {activePage === 'analytics' && <><BarChart2 className="w-4 h-4 text-[#1C1D21]" /> <span>Analytics & Statistics</span></>}
                  {activePage === 'reports' && <><FileText className="w-4 h-4 text-[#1C1D21]" /> <span>Reports</span></>}
                  {activePage === 'uikit' && <><Layers className="w-4 h-4 text-[#3F3B99]" /> <span>Design System & UI Components</span></>}
                </div>
              </nav>
            </div>

            {/* Top Right Icons */}
            <div className="flex items-center gap-2 sm:gap-3 relative">
              <div className="relative">
                <button
                  onClick={() => setNotificationsOpen(!notificationsOpen)}
                  aria-label="Notifications"
                  className={`w-9 h-9 rounded-full border flex items-center justify-center transition-colors relative ${
                    notificationsOpen
                      ? 'bg-[#1C1D21] text-white border-[#1C1D21]'
                      : 'border-black/[0.07] text-[#1C1D21] hover:bg-[#F4F5F8]'
                  }`}
                >
                  <Bell className="w-4 h-4" />
                  {unreadNotifCount > 0 && (
                    <span className="min-w-[17px] h-[17px] px-1 rounded-full bg-[#EF4444] text-white text-[10px] font-bold flex items-center justify-center absolute -top-1 -right-1 ring-2 ring-white">
                      {unreadNotifCount}
                    </span>
                  )}
                </button>

                {/* Interactive Notifications Center Popover */}
                {notificationsOpen && (
                  <>
                    <div
                      className="fixed inset-0 z-30"
                      onClick={() => setNotificationsOpen(false)}
                    />
                    <div className="fixed sm:absolute inset-x-3 sm:inset-x-auto sm:right-0 top-16 sm:top-12 sm:w-[380px] bg-white rounded-[24px] shadow-[0_20px_50px_-12px_rgba(0,0,0,0.18)] border border-black/[0.07] p-4 z-40 space-y-3 animate-bottom-sheet">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2">
                          <span className="text-[15px] font-semibold text-[#1C1D21]">Notifications</span>
                          {unreadNotifCount > 0 && (
                            <span className="px-2 py-0.5 rounded-full bg-[#FFECEB] text-[#942922] text-[10.5px] font-bold">
                              {unreadNotifCount} New
                            </span>
                          )}
                        </div>
                        <button
                          onClick={handleMarkAllRead}
                          className="text-[11.5px] font-semibold text-[#3F3B99] hover:underline"
                        >
                          Mark all read
                        </button>
                      </div>

                      {/* Filter Pills */}
                      <div className="flex items-center gap-1.5 bg-[#F4F5F8] p-1 rounded-full">
                        {['All', 'Unread'].map((tab) => (
                          <button
                            key={tab}
                            onClick={() => setNotificationsFilter(tab)}
                            className={`flex-1 py-1 rounded-full text-[11.5px] font-semibold transition-all ${
                              notificationsFilter === tab
                                ? 'bg-[#1C1D21] text-white shadow-2xs'
                                : 'text-[#6E717A] hover:text-[#1C1D21]'
                            }`}
                          >
                            {tab}
                          </button>
                        ))}
                      </div>

                      {/* Notification List */}
                      <div className="max-h-72 overflow-y-auto space-y-2 pr-0.5">
                        {notifications
                          .filter((n) => notificationsFilter === 'All' || n.unread)
                          .map((notif) => {
                            const theme = PASTEL_THEMES[notif.theme] || PASTEL_THEMES.periwinkle;
                            return (
                              <button
                                key={notif.id}
                                onClick={() => handleNotificationClick(notif)}
                                className={`w-full text-left p-3 rounded-2xl border transition-all flex items-start gap-3 ${
                                  notif.unread
                                    ? `${theme.bg} border-black/[0.05]`
                                    : 'bg-[#FAFBFD] border-black/[0.04] hover:bg-[#F4F5F8]'
                                }`}
                              >
                                <span className={`w-2.5 h-2.5 rounded-full mt-1.5 shrink-0 ${notif.unread ? theme.dot : 'bg-black/15'}`} />
                                <div className="min-w-0 flex-1">
                                  <div className="flex items-center justify-between gap-2">
                                    <span className="text-[12.5px] font-semibold text-[#1C1D21] truncate">{notif.title}</span>
                                    <span className="text-[10px] text-[#8A8D98] shrink-0">{notif.time}</span>
                                  </div>
                                  <p className="text-[11.5px] text-[#5A5D67] mt-0.5 line-clamp-2">{notif.desc}</p>
                                  <span className="inline-block mt-1.5 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-white text-[#1C1D21]">
                                    Open {notif.category} →
                                  </span>
                                </div>
                              </button>
                            );
                          })}
                        {notifications.filter((n) => notificationsFilter === 'All' || n.unread).length === 0 && (
                          <div className="text-center py-8 text-[12px] text-[#8A8D98]">
                            You&apos;re all caught up! No unread notifications.
                          </div>
                        )}
                      </div>
                    </div>
                  </>
                )}
              </div>
              <button
                onClick={() => setActivePage('messages')}
                title="Open Messages"
                className={`w-9 h-9 rounded-full border flex items-center justify-center transition-colors relative ${
                  activePage === 'messages'
                    ? 'bg-[#1C1D21] text-white border-[#1C1D21]'
                    : 'border-black/[0.07] text-[#1C1D21] hover:bg-[#F4F5F8]'
                }`}
              >
                <MessageSquare className="w-4 h-4" />
                {unreadMessagesCount > 0 && (
                  <span className="w-2 h-2 rounded-full bg-[#F59E0B] absolute top-1.5 right-2 ring-2 ring-white"></span>
                )}
              </button>
              <button
                onClick={() => setActivePage('uikit')}
                className="w-9 h-9 rounded-full border border-black/[0.07] flex items-center justify-center text-[#1C1D21] hover:bg-[#F4F5F8] transition-colors"
              >
                <Search className="w-4 h-4" />
              </button>
            </div>
          </header>

          {/* ================================================================
              VIEW: OVERVIEW DASHBOARD
             ================================================================ */}
          {activePage === 'overview' && (
            <div className="flex-1 overflow-y-auto p-5 sm:p-7 space-y-6">
              {/* Top Greeting Header */}
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.05]">
                <div>
                  <h1 className="text-[24px] font-semibold tracking-tight text-[#1C1D21]">Welcome back, Rasengan</h1>
                  <p className="text-[13px] text-[#8A8D98] mt-0.5">
                    Here is your teaching pulse, daily attendance summary, and upcoming academic milestones.
                  </p>
                </div>

                <div className="flex items-center gap-2.5">
                  <button
                    onClick={() => setActivePage('analytics')}
                    className="flex items-center gap-2 px-4 py-2.5 rounded-full border border-black/[0.08] text-[13px] font-medium text-[#1C1D21] hover:bg-[#F4F5F8] transition-colors"
                  >
                    <BarChart2 className="w-4 h-4" />
                    <span>View Statistics</span>
                  </button>
                  <button
                    onClick={() => setIsNewAssignmentOpen(true)}
                    className="flex items-center gap-2 bg-[#1C1D21] hover:bg-[#2E3036] text-white text-[13px] font-medium px-4 py-2.5 rounded-full shadow-xs transition-all active:scale-95 cursor-pointer"
                  >
                    <Plus className="w-4 h-4" />
                    <span>Quick Create</span>
                  </button>
                </div>
              </div>

              {/* 4 Pastel KPI Summary Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <div
                  onClick={() => setActivePage('attendance')}
                  className="bg-[#EEF8F3] rounded-[22px] p-5 cursor-pointer transition-transform hover:-translate-y-0.5 border border-black/[0.03]"
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[12.5px] font-semibold text-[#146C43]">Daily Attendance</span>
                    <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#10B981] shadow-2xs">
                      <CheckCircle2 className="w-4 h-4" />
                    </div>
                  </div>
                  <div className="text-[26px] font-bold text-[#1C1D21] mt-3">95.8%</div>
                  <div className="flex items-center justify-between mt-2 text-[11.5px] text-[#5A5D67]">
                    <span>83 / 87 Students Present</span>
                    <span className="font-semibold text-[#146C43]">+1.4%</span>
                  </div>
                </div>

                <div
                  onClick={() => setActivePage('exams')}
                  className="bg-[#ECEBFF] rounded-[22px] p-5 cursor-pointer transition-transform hover:-translate-y-0.5 border border-black/[0.03]"
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[12.5px] font-semibold text-[#3F3B99]">Upcoming Exams</span>
                    <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#7A74FF] shadow-2xs">
                      <FileCheck className="w-4 h-4" />
                    </div>
                  </div>
                  <div className="text-[26px] font-bold text-[#1C1D21] mt-3">{exams.length} Scheduled</div>
                  <div className="flex items-center justify-between mt-2 text-[11.5px] text-[#5A5D67]">
                    <span>Next: Math Class 302</span>
                    <span className="font-semibold text-[#3F3B99]">Feb</span>
                  </div>
                </div>

                <div
                  onClick={() => setActivePage('assignments')}
                  className="bg-[#FFF5E6] rounded-[22px] p-5 cursor-pointer transition-transform hover:-translate-y-0.5 border border-black/[0.03]"
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[12.5px] font-semibold text-[#8C5811]">Pending Grading</span>
                    <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#F59E0B] shadow-2xs">
                      <Bookmark className="w-4 h-4" />
                    </div>
                  </div>
                  <div className="text-[26px] font-bold text-[#1C1D21] mt-3">
                    {assignments.reduce((acc, a) => acc + a.submissions.filter(s => s.status === 'Needs Review').length, 0)} Items
                  </div>
                  <div className="flex items-center justify-between mt-2 text-[11.5px] text-[#5A5D67]">
                    <span>Across {assignments.length} assignments</span>
                    <span className="font-semibold text-[#8C5811]">Review</span>
                  </div>
                </div>

                <div
                  onClick={() => setActivePage('prep')}
                  className="bg-[#FFECEB] rounded-[22px] p-5 cursor-pointer transition-transform hover:-translate-y-0.5 border border-black/[0.03]"
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[12.5px] font-semibold text-[#942922]">Lesson Readiness</span>
                    <div className="w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#EF4444] shadow-2xs">
                      <BookOpen className="w-4 h-4" />
                    </div>
                  </div>
                  <div className="text-[26px] font-bold text-[#1C1D21] mt-3">
                    {Math.round(lessonPlans.reduce((a, b) => a + b.progress, 0) / lessonPlans.length)}%
                  </div>
                  <div className="flex items-center justify-between mt-2 text-[11.5px] text-[#5A5D67]">
                    <span>{lessonPlans.filter(p => p.status === 'Ready').length}/{lessonPlans.length} Modules Ready</span>
                    <span className="font-semibold text-[#942922]">On Track</span>
                  </div>
                </div>
              </div>

              {/* 12-Col Workspace: Left Today's Classes + Performance Chart (7 Cols) | Right Action Queue & Upcoming Exams (5 Cols) */}
              <div className="grid grid-cols-1 xl:grid-cols-12 gap-7 pt-2">
                {/* Left 7 Columns */}
                <div className="xl:col-span-7 xl:border-r xl:border-black/[0.05] xl:pr-7 space-y-6">
                  {/* Today's Schedule Snapshot */}
                  <div>
